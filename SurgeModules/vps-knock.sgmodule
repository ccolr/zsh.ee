#!name=VPS Knockd 独立控制
#!desc=每台 VPS 使用独立的开门、关门卡片。每次操作只处理对应 VPS：先检测当前状态，避免重复操作；必要时由独立短会话发送序列，再检测并显示是否成功。
#!arguments=vps1_name:VPS-1,vps1_host:vps1.example.com,vps1_open_ports:7123|8234|9345,vps1_close_ports:9345|8234|7123,vps1_check_port:80,vps2_name:VPS-2,vps2_host:vps2.example.com,vps2_open_ports:7123|8234|9345,vps2_close_ports:9345|8234|7123,vps2_check_port:80
#!arguments-desc=每台 VPS 分别配置名称、地址、开门序列、关门序列和检测端口。序列使用竖线 | 分隔且最多 5 个端口；检测端口只能为 80 或 443，且不能出现在敲门序列中。

[Script]
VPS-1-Knock-Open = type=generic,timeout=30,script-path=https://raw.githubusercontent.com/ccolr/zsh.ee/main/SurgeModules/vps-knock.js,argument="action=open&name={{{vps1_name}}}&host={{{vps1_host}}}&open={{{vps1_open_ports}}}&close={{{vps1_close_ports}}}&check_port={{{vps1_check_port}}}"
VPS-1-Knock-Close = type=generic,timeout=30,script-path=https://raw.githubusercontent.com/ccolr/zsh.ee/main/SurgeModules/vps-knock.js,argument="action=close&name={{{vps1_name}}}&host={{{vps1_host}}}&open={{{vps1_open_ports}}}&close={{{vps1_close_ports}}}&check_port={{{vps1_check_port}}}"
VPS-2-Knock-Open = type=generic,timeout=30,script-path=https://raw.githubusercontent.com/ccolr/zsh.ee/main/SurgeModules/vps-knock.js,argument="action=open&name={{{vps2_name}}}&host={{{vps2_host}}}&open={{{vps2_open_ports}}}&close={{{vps2_close_ports}}}&check_port={{{vps2_check_port}}}"
VPS-2-Knock-Close = type=generic,timeout=30,script-path=https://raw.githubusercontent.com/ccolr/zsh.ee/main/SurgeModules/vps-knock.js,argument="action=close&name={{{vps2_name}}}&host={{{vps2_host}}}&open={{{vps2_open_ports}}}&close={{{vps2_close_ports}}}&check_port={{{vps2_check_port}}}"

[Panel]
VPS-1-Knock-Open = title="🔓 {{{vps1_name}}} 开门",content="点击刷新：检查状态，必要时开门并验证",style=info,script-name=VPS-1-Knock-Open
VPS-1-Knock-Close = title="🔒 {{{vps1_name}}} 关门",content="点击刷新：检查状态，必要时关门并验证",style=info,script-name=VPS-1-Knock-Close
VPS-2-Knock-Open = title="🔓 {{{vps2_name}}} 开门",content="点击刷新：检查状态，必要时开门并验证",style=info,script-name=VPS-2-Knock-Open
VPS-2-Knock-Close = title="🔒 {{{vps2_name}}} 关门",content="点击刷新：检查状态，必要时关门并验证",style=info,script-name=VPS-2-Knock-Close
