#!name=VPS Knockd 控制
#!desc=先从当前网络 DIRECT 探测 VPS 的 nginx；需要操作时快速发送 knockd 序列并立即结束，避免 TCP SYN 重传打乱顺序。等待 1–2 秒后再次刷新即可验证。关门只影响当前出口 IP，旧出口规则应由 VPS 端 cmd_timeout 自动回收。
#!arguments=vps_names:VPS-1|VPS-2,vps_hosts:vps1.example.com|vps2.example.com,open_ports:7123|8234|9345,close_ports:9345|8234|7123,check_port:80
#!arguments-desc=名称和主机列表使用竖线 | 分隔。每组敲门序列最多 5 个端口。check_port 填写受 knockd 规则保护的 nginx 端口，推荐 80；填写 443 时主机名应与 HTTPS 证书匹配。

[Script]
VPS-Knock-Open = type=generic,timeout=120,script-path=https://raw.githubusercontent.com/ccolr/zsh.ee/main/SurgeModules/vps-knock.js,argument="action=open&names={{{vps_names}}}&hosts={{{vps_hosts}}}&open={{{open_ports}}}&close={{{close_ports}}}&check_port={{{check_port}}}"
VPS-Knock-Close = type=generic,timeout=120,script-path=https://raw.githubusercontent.com/ccolr/zsh.ee/main/SurgeModules/vps-knock.js,argument="action=close&names={{{vps_names}}}&hosts={{{vps_hosts}}}&open={{{open_ports}}}&close={{{close_ports}}}&check_port={{{check_port}}}"

[Panel]
VPS-Knock-Open = title="🔓 VPS 开门（当前出口）",content="点击刷新：已连通则跳过，否则发送开门序列；等待 1–2 秒后再次刷新验证",style=info,script-name=VPS-Knock-Open
VPS-Knock-Close = title="🔒 VPS 关门（当前出口）",content="点击刷新：先检测连通性，再发送关门序列；等待 1–2 秒后再次刷新验证",style=info,script-name=VPS-Knock-Close
