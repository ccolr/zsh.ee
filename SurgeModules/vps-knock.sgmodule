#!name=VPS Knockd 独立控制
#!desc=单台 VPS 的独立开门、关门控制。每次操作先检测当前状态，避免重复操作；必要时由独立短会话发送序列，再检测并显示是否成功。
#!arguments=vps_name:VPS-1,vps_host:vps1.example.com,open_ports:7123|8234|9345,close_ports:9345|8234|7123,check_port:80
#!arguments-desc=配置 VPS 名称、地址、开门序列、关门序列和检测端口。序列使用竖线 | 分隔且最多 5 个端口；检测端口只能为 80 或 443，且不能出现在敲门序列中。

[Script]
VPS-Knock-Open = type=generic,timeout=30,script-path=https://raw.githubusercontent.com/ccolr/zsh.ee/main/SurgeModules/vps-knock.js,argument="action=open&name={{{vps_name}}}&host={{{vps_host}}}&open={{{open_ports}}}&close={{{close_ports}}}&check_port={{{check_port}}}"
VPS-Knock-Close = type=generic,timeout=30,script-path=https://raw.githubusercontent.com/ccolr/zsh.ee/main/SurgeModules/vps-knock.js,argument="action=close&name={{{vps_name}}}&host={{{vps_host}}}&open={{{open_ports}}}&close={{{close_ports}}}&check_port={{{check_port}}}"

[Panel]
VPS-Knock-Open = title="🔓 {{{vps_name}}} 开门",content="点击刷新：检查状态，必要时开门并验证",style=info,script-name=VPS-Knock-Open
VPS-Knock-Close = title="🔒 {{{vps_name}}} 关门",content="点击刷新：检查状态，必要时关门并验证",style=info,script-name=VPS-Knock-Close
