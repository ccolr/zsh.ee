{
    "log": {
        "access": "/var/log/xray/access.log",
        "error": "/var/log/xray/error.log",
        "loglevel": "warning",
        "dnsLog": false,
        "maskAddress": "quarter"
    },
    "dns": {
        "servers": [
            {
                "address": "https+local://1.1.1.1/dns-query",
                "unexpectedIPs": [
                    "geoip:cn"
                ]
            },
            {
                "address": "https+local://8.8.8.8/dns-query",
                "unexpectedIPs": [
                    "geoip:cn"
                ]
            },
            "localhost"
        ],
        "queryStrategy": "UseSystem",
        "disableCache": false,
        "serveStale": true,
        "serveExpiredTTL": 3600,
        "disableFallback": false,
        "enableParallelQuery": false,
        "useSystemHosts": false
    },
    "inbounds": [
        {
            "listen": "0.0.0.0",
            "port": 443,
            "protocol": "vless",
            "settings": {
                "users": [
                    {
                        "id": "<your uuid>",
                        "level": 0,
                        "email": "i@eva.cm",
                        "flow": "xtls-rprx-vision"
                    }
                ],
                "flow": "",
                "decryption": "none"
            },
            "streamSettings": {
                "method": "raw",
                "security": "reality",
                "realitySettings": {
                    "target": "127.0.0.1:10443",
                    "serverNames": [
                        "<your domain>"
                    ],
                    "privateKey": "<your private key>",
                    "shortIds": [
                        "<your short id>",
                        "<your short id>"
                    ]
                }
            },
            "sniffing": {
                "enabled": true,
                "destOverride": [
                    "http",
                    "tls",
                    "quic"
                ],
                "metadataOnly": false,
                "domainsExcluded": [
                    "courier.push.apple.com",
                    "Mijia Cloud",
                    "dlg.io.mi.com"
                ],
                "routeOnly": true
            },
            "tag": "us-vless-in"
        }
    ],
    "outbounds": [
        {
            "protocol": "freedom",
            "settings": {
                "finalRules": [
                    {
                        "action": "block",
                        "network": "udp",
                        "port": "443",
                        "blockDelay": "0"
                    },
                    {
                        "action": "block",
                        "ip": [
                            "0.0.0.0/8",
                            "10.0.0.0/8",
                            "fc00::/7",
                            "fe80::/10",
                            "geoip:private",
                            "geoip:cn"
                        ]
                    },
                    {
                        "action": "block",
                        "network": "tcp",
                        "port": "25,465,587,2525"
                    }
                ]
            },
            "streamSettings": {
                "sockopt": {
                    "domainStrategy": "UseIP"
                }
            },
            "tag": "direct"
        },
        {
            "protocol": "blackhole",
            "tag": "block"
        }
    ],
    "routing": {
        "domainStrategy": "IPOnDemand",
        "rules": [
            {
                "ip": [
                    "0.0.0.0/8",
                    "10.0.0.0/8",
                    "fc00::/7",
                    "fe80::/10",
                    "geoip:private",
                    "geoip:cn"
                ],
                "outboundTag": "block"
            },
            {
                "network": "tcp",
                "port": "25,465,587,2525",
                "outboundTag": "block"
            },
            {
                "inboundTag": [
                    "us-vless-in"
                ],
                "outboundTag": "direct"
            }
        ]
    },
    "policy": {
        "levels": {
            "0": {
                "handshake": 60,
                "connIdle": 300,
                "uplinkOnly": 0,
                "downlinkOnly": 0,
                "statsUserUplink": false,
                "statsUserDownlink": false
            }
        },
        "system": {
            "statsInboundUplink": false,
            "statsInboundDownlink": false,
            "statsOutboundUplink": false,
            "statsOutboundDownlink": false
        }
    }
}